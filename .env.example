# AI Provider Configuration
# Choose: auto, rule, ollama, gemini, zai, or openai
AI_PROVIDER=auto

# Z.AI (GLM) — primary provider when a key is set
ZAI_API_KEY=
ZAI_MODEL=glm-4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Gemini — used for text, and for audio when the selected model accepts inline audio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Configuration (optional fallback; paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Store student recordings after marking (default off)
STORE_AUDIO=false

# Session signing key. Local development falls back to an insecure default.
# PRODUCTION REQUIRES THIS: the app refuses to start without a stable value,
# because a changing key logs every student out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database
# Local default (if unset): sqlite:///.../instance/speaked.db
# Render: set DATABASE_URL to the PostgreSQL connection string from the Render database
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
#
# In production (Render sets RENDER=true automatically, or set
# SPEAKED_ENV=production elsewhere) DATABASE_URL MUST be PostgreSQL. The app will
# not start on SQLite in production and will never silently fall back to it,
# because the hosted filesystem is wiped on every redeploy.
# SPEAKED_ENV=production

# --- Required production configuration ---
# DATABASE_URL=postgresql://...   PostgreSQL connection string
# SECRET_KEY=...                  stable random secret
# AI_PROVIDER=gemini              audio-capable examiner
# GEMINI_API_KEY=...              server-side only, never committed
# GEMINI_MODEL=gemini-3.6-flash

# To use real AI:
# 1. Set ZAI_API_KEY or GEMINI_API_KEY (never commit the real key)
# 2. Or run Ollama locally and set AI_PROVIDER=ollama
# 3. AI_PROVIDER=rule will not produce exam marks (marking_unavailable)
