# AI Provider Configuration
# Choose: auto, rule, ollama, gemini, zai, or openai
AI_PROVIDER=auto

# Z.AI (GLM) — primary provider when a key is set
ZAI_API_KEY=
ZAI_MODEL=glm-4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Gemini — used for text, and for audio when the selected model accepts inline audio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Configuration (optional fallback; paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Task 3 photographs are loaded from Getty Images (public oEmbed).
# PICTURE_SOURCE=getty
# Tests use PICTURE_SOURCE=local.

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Store student recordings after marking (default off)
STORE_AUDIO=false

# Never enable debug on a public host
FLASK_DEBUG=0

# Session signing key. Local development falls back to an insecure default.
# PRODUCTION REQUIRES THIS: the app refuses to start without a stable value,
# because a changing key logs every student out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Bump this to log every existing session out. Leave it unchanged afterwards
# so people who sign in again stay signed in across deploys.
# SESSION_VERSION=1

# Database
# Local default (if unset): sqlite:///.../instance/speaked.db
# Render: set DATABASE_URL to the PostgreSQL connection string from the Render database
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
#
# In production (Render sets RENDER=true automatically, or set
# SPEAKED_ENV=production elsewhere) DATABASE_URL MUST be PostgreSQL. The app will
# not start on SQLite in production and will never silently fall back to it,
# because the hosted filesystem is wiped on every redeploy.
# SPEAKED_ENV=production

# --- Required production configuration ---
# DATABASE_URL=postgresql://...   PostgreSQL connection string
# SECRET_KEY=...                  stable random secret
# AI_PROVIDER=gemini              audio-capable examiner
# GEMINI_API_KEY=...              server-side only, never committed
# GEMINI_MODEL=gemini-3.6-flash

# To use real AI:
# 1. Set ZAI_API_KEY or GEMINI_API_KEY (never commit the real key)
# 2. Or run Ollama locally and set AI_PROVIDER=ollama
# 3. AI_PROVIDER=rule will not produce exam marks (marking_unavailable)

# --- Advertising (publisher script loads on home, dashboard, information, privacy) ---
# ADS_ENABLED=true
# ADS_PROVIDER=adsense
# AD_CLIENT_ID=ca-pub-3990201330574869
# AD_SLOT_HOME=
# AD_SLOT_DASHBOARD=
# AD_SLOT_INFORMATION=
# AD_SLOT_PRIVACY=
# ADS_TEST_MODE=false
# ADS_CONSENT_REQUIRED=false
#
# Real ads load only when ADS_ENABLED=true, ADS_TEST_MODE=false, and AD_CLIENT_ID
# is a live ca-pub- publisher id (digits only). Placeholder IDs never load a
# third-party script.
#
# Before enabling production ads, in the AdSense account block at least:
# gambling, adult, dating, alcohol, tobacco, weapons, drugs, politics,
# get-rich-quick, and similar sensitive categories. SpeakEd uses
# non-personalized ads and Google's under-age-of-consent tag; it does not
# classify individual creatives itself.

# --- Subscriptions (sandbox by default; no real charges) ---
# PAYMENT_PROVIDER=fake
# PAYMENT_TEST_MODE=true
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# FREE_PRACTICE_EXAMS_PER_MONTH=4
# FREE_RETRY_MARKING_PER_MONTH=2
# FREE_INFO_GEN_PER_MONTH=8
# PREMIUM_PRICE_AMOUNT=499
# PREMIUM_CURRENCY=gbp
# PREMIUM_INTERVAL=month
# PREMIUM_PLAN_NAME=Premium
# FREE_PLAN_NAME=Free
#
# Use PAYMENT_PROVIDER=stripe only with Stripe test keys (sk_test_...).
# Live keys are rejected while PAYMENT_TEST_MODE=true. Never commit secrets.
