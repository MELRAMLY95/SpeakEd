# AI Provider Configuration
# Choose: auto, rule, ollama, or openai
AI_PROVIDER=auto

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (if using Ollama - free local AI)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# To use real AI:
# 1. For OpenAI (Best Quality, Paid): Get an API key from https://platform.openai.com/api-keys
#    Set OPENAI_API_KEY=your_key_here
#    Set AI_PROVIDER=openai
#    Recommended model: gpt-4o-mini (cost-effective) or gpt-4o (best quality)
#
# 2. For Ollama (Free, Good Quality): Install Ollama from https://ollama.com
#    Run: ollama pull llama3.2
#    Set AI_PROVIDER=ollama
#    Other good models: llama3.1, mistral, phi3
#
# 3. For rule-based (No AI Required): Set AI_PROVIDER=rule
#    This uses simple keyword matching - less accurate but no API needed

# RECOMMENDED: Start with Ollama (free) to test, then upgrade to OpenAI for best results

